# CeliacSafe — Environment Variables
# Copy this file to .env.local and fill in the values.
# The app runs without any of these set — they are only needed for Supabase integration.

# ─── Supabase (required for auth, database, and storage) ─────────────────────
# Create a free project at https://supabase.com
# Find these values in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PHOTOS_BUCKET=place-photos

# Service role key — NEVER expose this in the browser.
# Only used in server-side admin tasks (e.g., seeding, moderation).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Nominatim base URL for server-side NZ address lookup.
# Defaults to the public server: https://nominatim.openstreetmap.org
NOMINATIM_BASE_URL=

# Optional: User-Agent header for Nominatim requests.
# Keep this descriptive if you run your own deployment.
NOMINATIM_USER_AGENT=

# Optional: contact email appended to Nominatim requests.
NOMINATIM_EMAIL=
